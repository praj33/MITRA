# =================================================================
# MITRA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' in the root or backend folder
# =================================================================

ENV=production
ENVIRONMENT=production
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./assistant_core.db
API_KEY=mitra_production_secret_key
JWT_SECRET_KEY=mitra_super_secret_jwt_key_2026
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
MONGODB_URI=mongodb://localhost:27017/mitra_db
DATABASE_NAME=mitra_db
FRONTEND_URL=http://localhost:3000

# ── 1. PRIMARY LLM PROVIDER (Groq — Sub-150ms Latency) ───────────────
COMPANION_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── 2. LIVE WEATHER ENGINE (WeatherAPI.com — 1M Calls/Mo) ───────────
WEATHER_API_KEY=your_weather_api_key_here

# ── 3. SECONDARY LLM FALLBACK (Google Gemini API) ───────────────────
GOOGLE_API_KEY=your_google_gemini_key_here
GEMINI_MODEL=gemini-flash-latest

# ── 4. WEB SEARCH INTELLIGENCE ENGINE (Tavily AI Search) ───────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── 5. UNIGURU V2 ENGINE (Fallback Provider) ───────────────────────
UNIGURU_URL=https://uniguru-v2.onrender.com/new_query
UNIGURU_API_KEY=uniguru_secret_123

# ── 6. SELF-HOSTED PRIVATE STACK (Option B - Optional) ─────────────
# SEARXNG_URL=http://localhost:8888
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1
